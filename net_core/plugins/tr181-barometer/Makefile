include $(TOPDIR)/rules.mk
 
PKG_NAME:=tr181-barometer
PKG_VERSION:=feature_PCF_2326
SHORT_DESCRIPTION:=TR-181 Barometer Manager
 
PKG_SOURCE_PROTO:=git
PKG_SOURCE_VERSION:=feature_PCF_2326
PKG_SOURCE_URL:=https://gitlab.com/prpl-foundation/components/core/plugins/tr181-barometer.git
PKG_MIRROR_HASH:=3a540561db310dcc7ceea0ce0900622939a2e1c91beab15fad57f01b1abe80ca
PKG_BUILD_DIR:=$(BUILD_DIR)/$(PKG_NAME)-$(PKG_VERSION)
PKG_MAINTAINER:= Sriya Nair <sriya.n@tataelxsi.co.in>
PKG_LICENSE:=BSD-2-Clause-Patent
PKG_LICENSE_FILES:=LICENSE

COMPONENT:=tr181-barometer
 
PKG_RELEASE:=1
 
define SAHInit/Install
	install -d $(1)/etc/rc.d/
ifneq ($(CONFIG_PACKAGE_procd),y)
	ln -sfr $(1)/etc/init.d/$(COMPONENT) $(1)/etc/rc.d/S$(CONFIG_AMX_TR181_BAROMETER_ORDER)$(COMPONENT)
	ln -sfr $(1)/etc/init.d/$(COMPONENT) $(1)/etc/rc.d/K$(CONFIG_AMX_TR181_BAROMETER_ORDER)$(COMPONENT)
endif
endef
 
include $(INCLUDE_DIR)/package.mk

define Package/$(PKG_NAME)
  CATEGORY:=prpl Foundation
  SUBMENU:=TR-181 Managers
  TITLE:=$(SHORT_DESCRIPTION)
  URL:=https://gitlab.com/prpl-foundation/components/core/plugins/tr181-barometer
  DEPENDS += +libamxc
  DEPENDS += +libamxp
  DEPENDS += +libamxd
  DEPENDS += +libamxb
  DEPENDS += +libamxo
  DEPENDS += +libamxm
  DEPENDS += +libsahtrace
  MENU:=1
endef
 
define Package/$(PKG_NAME)/description
	tr181-barometer implementation
endef

define Build/Compile
	$(call Build/Compile/Default, STAGINGDIR=$(STAGING_DIR) CONFIGDIR=$(STAGING_DIR) PKG_CONFIG_PATH=$(STAGING_DIR)/usr/lib/pkgconfig LIBDIR=/usr/lib INSTALL_LIB_DIR=/lib INSTALL_BIN_DIR=/bin RAW_VERSION=$(PKG_VERSION) HARDCO_HAL_DIR=$(STAGING_DIR)/usr/include CONFIG_AMX_TR181_BAROMETER_ORDER=$(CONFIG_AMX_TR181_BAROMETER_ORDER) CONFIG_PACKAGE_procd=$(CONFIG_PACKAGE_procd) CONFIG_AMX_TR181_BAROMETER_IIO_PATH=$(CONFIG_AMX_TR181_BAROMETER_IIO_PATH) CONFIG_AMX_TR181_BAROMETER_VERTICAL_UNCERTAINTY=$(CONFIG_AMX_TR181_BAROMETER_VERTICAL_UNCERTAINTY) CONFIG_AMX_TR181_BAROMETER_PRESSURE_ACCURACY_PA=$(CONFIG_AMX_TR181_BAROMETER_PRESSURE_ACCURACY_PA))
endef

define Build/Install
	$(call Build/Install/Default, install INSTALL=install D=$(PKG_INSTALL_DIR) DEST=$(PKG_INSTALL_DIR) STAGINGDIR=$(STAGING_DIR) CONFIGDIR=$(STAGING_DIR) PV=$(PKG_VERSION) PKG_CONFIG_LIBDIR=$(STAGING_DIR)/usr/lib/pkgconfig LIBDIR=/usr/lib INSTALL_LIB_DIR=/lib INSTALL_BIN_DIR=/bin RAW_VERSION=$(PKG_VERSION) HARDCO_HAL_DIR=$(STAGING_DIR)/usr/include CONFIG_AMX_TR181_BAROMETER_ORDER=$(CONFIG_AMX_TR181_BAROMETER_ORDER) CONFIG_PACKAGE_procd=$(CONFIG_PACKAGE_procd) CONFIG_AMX_TR181_BAROMETER_IIO_PATH=$(CONFIG_AMX_TR181_BAROMETER_IIO_PATH) CONFIG_AMX_TR181_BAROMETER_VERTICAL_UNCERTAINTY=$(CONFIG_AMX_TR181_BAROMETER_VERTICAL_UNCERTAINTY) CONFIG_AMX_TR181_BAROMETER_PRESSURE_ACCURACY_PA=$(CONFIG_AMX_TR181_BAROMETER_PRESSURE_ACCURACY_PA))
	$(call SAHInit/Install,$(PKG_INSTALL_DIR))
endef

define Build/InstallDev
	$(call Build/Install/Default, install INSTALL=install D=$(STAGING_DIR) DEST=$(STAGING_DIR) STAGINGDIR=$(STAGING_DIR) CONFIGDIR=$(STAGING_DIR) PV=$(PKG_VERSION) PKG_CONFIG_LIBDIR=$(STAGING_DIR)/usr/lib/pkgconfig LIBDIR=/usr/lib INSTALL_LIB_DIR=/lib INSTALL_BIN_DIR=/bin RAW_VERSION=$(PKG_VERSION) HARDCO_HAL_DIR=$(STAGING_DIR)/usr/include CONFIG_AMX_TR181_BAROMETER_ORDER=$(CONFIG_AMX_TR181_BAROMETER_ORDER) CONFIG_PACKAGE_procd=$(CONFIG_PACKAGE_procd) CONFIG_AMX_TR181_BAROMETER_IIO_PATH=$(CONFIG_AMX_TR181_BAROMETER_IIO_PATH) CONFIG_AMX_TR181_BAROMETER_VERTICAL_UNCERTAINTY=$(CONFIG_AMX_TR181_BAROMETER_VERTICAL_UNCERTAINTY) CONFIG_AMX_TR181_BAROMETER_PRESSURE_ACCURACY_PA=$(CONFIG_AMX_TR181_BAROMETER_PRESSURE_ACCURACY_PA))
	$(call SAHInit/Install,$(STAGING_DIR))
endef
 
define Package/$(PKG_NAME)/install
	$(CP) $(PKG_INSTALL_DIR)/* $(1)/
	if [ -d ./files ]; then \
		$(CP) ./files/* $(1)/; \
	fi
	find $(1) -name *.a -exec rm {} +;
	find $(1) -name *.h -exec rm {} +;
	find $(1) -name *.pc -exec rm {} +;
endef 

define Package/$(PKG_NAME)/config
	source "$(SOURCE)/Config.in"
endef

$(eval $(call BuildPackage,$(PKG_NAME)))
