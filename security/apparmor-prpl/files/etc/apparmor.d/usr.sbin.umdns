abi <abi/3.0>,

include <tunables/global>

profile umdns /usr/sbin/umdns flags=(attach_disconnected, complain) {
  include <abstractions/base>
  include <abstractions/nameservice>

  capability net_raw,
  capability dac_override,
  capability kill,
  capability dac_read_search,

  network unix stream,

  /etc/seccomp/umdns.json r,
  /etc/umdns/ r,
  /etc/umdns/* r,
}
