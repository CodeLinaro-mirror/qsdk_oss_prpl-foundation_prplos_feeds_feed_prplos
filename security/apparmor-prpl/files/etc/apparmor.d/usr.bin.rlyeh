# vim:syntax=apparmor
# AppArmor policy for rlyeh
# ###AUTHOR###
# ###COPYRIGHT###
# ###COMMENT###

include <tunables/global>

# No template variables specified

profile rlyeh /usr/bin/rlyeh flags=(attach_disconnected, complain) {
  include <abstractions/base>

  /usr/bin/rlyeh mr,
  /etc/amx/global.d/ r,
  /etc/amx/global.d/01_global_variables.odl r,
  /etc/amx/modules/global_trace.odl r,
  /etc/amx/modules/mod_sahtrace.odl r,
  /etc/amx/rlyeh/rlyeh.odl r,
  /etc/amx/rlyeh/rlyeh_defaults.odl r,
  /etc/amx/rlyeh/rlyeh_definition.odl r,
  /lcm/rlyeh/images/ r,
  /usr/bin/mods/amxb/ r,
  /usr/bin/mods/amxb/05-mod-amxb-ubus.so mr,

}
