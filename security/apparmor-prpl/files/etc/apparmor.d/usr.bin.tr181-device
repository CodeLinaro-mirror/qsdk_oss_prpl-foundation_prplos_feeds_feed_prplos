# vim:syntax=apparmor
# AppArmor policy for tr181-device
# ###AUTHOR###
# ###COPYRIGHT###
# ###COMMENT###

include <tunables/global>

# No template variables specified

profile tr181-device /usr/bin/tr181-device flags=(attach_disconnected, complain) {
  include <abstractions/base>

  /usr/bin/tr181-device mr,
  /etc/amx/global.d/ r,
  /etc/amx/global.d/01_global_variables.odl r,
  /etc/amx/modules/global_trace.odl r,
