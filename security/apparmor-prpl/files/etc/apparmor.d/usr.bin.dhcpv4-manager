# vim:syntax=apparmor
# AppArmor policy for dhcpv4-manager
# ###AUTHOR###
# ###COPYRIGHT###
# ###COMMENT###

include <tunables/global>

# No template variables specified

profile dhcpv4-manager /usr/bin/dhcpv4-manager flags=(attach_disconnected, complain) {
  include <abstractions/base>

  capability kill,
  
  /usr/bin/dhcpv4-manager mr,
  /etc/amx/dhcpv4-manager/dhcpv4-manager.odl r,
  /etc/amx/dhcpv4-manager/dhcpv4-manager_definition.odl r,
  /etc/amx/dhcpv4-manager/extensions/ r,
  /etc/amx/dhcpv4-manager/extensions/dhcpv4-manager_usp.odl r,
  /etc/amx/dhcpv4-manager/server/dhcpv4-manager-server-pool.odl r,
  /etc/amx/dhcpv4-manager/server/dhcpv4-manager-server.odl r,
  /etc/amx/global.d/ r,
  /etc/amx/global.d/01_global_variables.odl r,
  /etc/amx/modules/global_ip_interfaces.odl r,
  /etc/amx/modules/global_trace.odl r,
  /etc/amx/modules/global_variables.odl r,
  /etc/amx/modules/mod_pcm_svc.odl r,
  /etc/amx/modules/mod_sahtrace.odl r,
  /etc/amx/modules/usp/local-agent.odl r,
  /etc/config/dhcpv4-manager/odl/dhcpv4-manager.odl rw,
  /etc/config/dhcpv4-manager/odl/dhcpv4-manager.odl.tmp rw,
  /etc/dnsmasq.conf rw,
  /usr/bin/mods/amxb/ r,
  /usr/bin/mods/amxb/05-mod-amxb-ubus.so mr,
  /usr/bin/mods/usp/ r,
  /usr/bin/mods/usp/mod-amxb-usp.so mr,

}

