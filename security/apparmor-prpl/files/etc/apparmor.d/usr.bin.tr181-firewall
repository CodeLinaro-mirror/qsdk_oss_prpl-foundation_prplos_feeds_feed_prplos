  /etc/amx/modules/usp/local-agent.odl r,
  /etc/amx/tr181-firewall/connectiontracking_definition.odl r,
  /etc/amx/tr181-firewall/dmz_definition.odl r,
  /etc/amx/tr181-firewall/extensions/ r,
  /etc/amx/tr181-firewall/extensions/deprecated_ifsetting_definition.odl r,
