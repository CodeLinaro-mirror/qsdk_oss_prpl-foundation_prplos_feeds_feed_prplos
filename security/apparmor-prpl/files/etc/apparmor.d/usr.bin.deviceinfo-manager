  /etc/logrotate.d/syslog-amxmon-procmon.conf w,
  /etc/logrotate.d/syslog-cmon-cpu0.conf w,
  /etc/logrotate.d/syslog-cmon-cpu1.conf w,
  /etc/logrotate.d/syslog-dhcp.conf w,
