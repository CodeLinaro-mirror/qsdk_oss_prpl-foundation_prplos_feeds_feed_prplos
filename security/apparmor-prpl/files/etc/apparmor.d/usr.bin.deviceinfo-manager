  /etc/amx/deviceinfo-manager/deviceinfo_mac_address_rpc.odl r,
  /etc/amx/deviceinfo-manager/deviceinfo_prefix.odl r,
  /etc/amx/deviceinfo-manager/deviceinfo_vendorlogfile_1.odl r,
  /etc/amx/deviceinfo-manager/extensions/ r,
  /etc/amx/deviceinfo-manager/extensions/deviceinfo-manager_requires_users.odl r,
  /etc/amx/deviceinfo-manager/extensions/deviceinfo-manager_usp.odl r,
  /etc/amx/global.d/ r,
  /etc/amx/global.d/01_global_variables.odl r,
